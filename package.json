{
    "name": "@frontfactory/readmore",
    "version": "1.2.0",
    "description": "Lightweight plugin to clamp text to N lines with ellipsis and a read more action.",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "lint:js": "eslint --fix .",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "prepare": "husky && npm run build",
        "release": "semantic-release"
    },
    "engines": {
        "node": ">=20.19"
    },
    "main": "./dist/readmore.js",
    "types": "./dist/readmore.d.ts",
    "exports": {
        ".": {
            "types": "./dist/readmore.d.ts",
            "import": "./dist/readmore.js"
        },
        "./style.css": "./dist/readmore.css",
        "./package.json": "./package.json"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.3",
        "@commitlint/config-conventional": "^21.0.1",
        "@front-factory/eslint-config": "^2.4.2",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/git": "^10.0.1",
        "@semantic-release/github": "^12.0.6",
        "@vitest/coverage-v8": "^4.1.5",
        "conventional-changelog-conventionalcommits": "^9.3.1",
        "eslint": "^10.3.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "lightningcss": "^1.32.0",
        "semantic-release": "^25.0.3",
        "typescript": "^5.4.0",
        "typescript-eslint": "^8.59.2",
        "vite": "^8.0.11",
        "vite-plugin-dts": "^5.0.0",
        "vite-plugin-static-copy": "^4.1.0",
        "vitest": "^4.1.5"
    },
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "keywords": [
        "readmore",
        "expand",
        "collapse",
        "front-end"
    ],
    "license": "MIT",
    "homepage": "https://github.com/front-factory/readmore",
    "bugs": {
        "url": "https://github.com/front-factory/readmore/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/front-factory/readmore.git"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
