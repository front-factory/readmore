{
    "name": "@frontfactory/readmore",
    "version": "0.0.0",
    "description": "Lightweight plugin to clamp text to N lines with ellipsis and a read more button.",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "prepare": "husky"
    },
    "engines": {
        "node": ">=20.19"
    },
    "main": "./dist/readmore.js",
    "module": "./dist/readmore.js",
    "types": "./dist/readmore.d.ts",
    "exports": {
        ".": {
            "types": "./dist/readmore.d.ts",
            "import": "./dist/readmore.js"
        },
        "./style.css": "./dist/readmore.css",
        "./package.json": "./package.json"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.3",
        "@commitlint/config-conventional": "^20.5.3",
        "husky": "^9.1.7",
        "typescript": "^5.4.0",
        "vite": "^8.0.11",
        "vite-plugin-dts": "^5.0.0",
        "vite-plugin-static-copy": "^4.1.0"
    },
    "files": [
        "dist"
    ],
    "keywords": [
        "readmore",
        "expand",
        "collapse",
        "front-end"
    ],
    "license": "MIT",
    "homepage": "https://github.com/front-factory/readmore",
    "bugs": {
        "url": "https://github.com/front-factory/readmore/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/front-factory/readmore.git"
    },
    "publishConfig": {
        "access": "public"
    }
}
