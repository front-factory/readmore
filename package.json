{
    "name": "@frontfactory/readmore",
    "version": "1.4.0",
    "description": "Zero-dependency plugin to truncate text to N lines or a fixed height, with an ellipsis and an accessible read more / read less toggle.",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "lint": "eslint .",
        "lint:js": "eslint --fix .",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --project unit",
        "test:browser": "vitest run --project browser --outputFile.junit=junit-browser.xml",
        "test:watch": "vitest",
        "test:coverage": "vitest run --project unit --coverage",
        "prepare": "husky",
        "prepack": "npm run build",
        "release": "semantic-release"
    },
    "engines": {
        "node": "^22.22.2 || >=24.15"
    },
    "main": "./dist/readmore.js",
    "types": "./dist/readmore.d.ts",
    "unpkg": "./dist/readmore.iife.js",
    "jsdelivr": "./dist/readmore.iife.js",
    "exports": {
        ".": {
            "types": "./dist/readmore.d.ts",
            "import": "./dist/readmore.js",
            "default": "./dist/readmore.js"
        },
        "./style.css": "./dist/readmore.css",
        "./package.json": "./package.json"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@front-factory/eslint-config": "^2.4.2",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/git": "^11.0.1",
        "@semantic-release/github": "^12.0.9",
        "@vitest/browser-playwright": "^5.0.0",
        "@vitest/coverage-v8": "^5.0.0",
        "conventional-changelog-conventionalcommits": "^9.3.1",
        "eslint": "^10.10.0",
        "husky": "^9.1.7",
        "jsdom": "^30.0.1",
        "lightningcss": "^1.33.0",
        "playwright": "^1.63.0",
        "semantic-release": "^25.0.9",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.3.0",
        "vite-plugin-dts": "^5.1.0",
        "vite-plugin-static-copy": "^4.1.1",
        "vitest": "^5.0.0"
    },
    "keywords": [
        "readmore",
        "read-more",
        "show-more",
        "truncate",
        "text-truncate",
        "line-clamp",
        "clamp",
        "ellipsis",
        "expand",
        "collapse",
        "typescript",
        "vanilla-js",
        "a11y"
    ],
    "author": "Front Factory",
    "license": "MIT",
    "homepage": "https://github.com/front-factory/readmore",
    "bugs": {
        "url": "https://github.com/front-factory/readmore/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/front-factory/readmore.git"
    },
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
